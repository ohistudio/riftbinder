# Secrets — never. The Riot key lives here; the RSG tokens are blanked in
# Scene.scene before every commit (see tools/check-no-tokens.sh).
secrets/
*.pem
*.env

# Generated by Lens Studio. Regenerated on open; committing them only makes
# every diff enormous.
Cache/
Workspaces/
Support/
PluginsUserPreferences/
*.lock

# One-shot asset generator scripts; the outputs in Assets/GeneratedSFX are
# what matters and they ARE committed.
tempAssetGen/

# Local editor state
leaf_plugin_settings.json
.DS_Store

